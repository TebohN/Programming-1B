import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Single-dimensional array
        String[] productNames = {
            "Cozy Nights Monarch mattress",
            "Restonic Barbados mattress",
            "Sealy Phuket mattress"
        };

        // Two-dimensional array
        // 3 products and 3 months
        int[][] monthlySales = new int[3][3];

        // Enter sales information
        for (int i = 0; i < productNames.length; i++) {

            for (int j = 0; j < 3; j++) {

                System.out.print(
                    "Enter number of sales for month "
                    + (j + 1) + " for "
                    + productNames[i] + ": "
                );

                monthlySales[i][j] = input.nextInt();
            }

            System.out.println();
        }

        // Create Product object
        Product product = new Product(productNames, monthlySales);

        // Create PrintProduct object
        PrintProduct printer = new PrintProduct();

        // Display report
        printer.PrintReport(product);

        input.close();
    }
}
